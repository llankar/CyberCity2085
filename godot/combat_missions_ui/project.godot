; Engine configuration for CyberCity 2085 combat mission UI.
; Open with: godot --path godot/combat_missions_ui -- --handoff runtime/godot_combat/mission_handoff.json

config_version=5

[application]
config/name="CyberCity 2085 Combat UI"
run/main_scene="res://scenes/combat_mission_ui.tscn"
config/features=PackedStringArray("4.2")

[autoload]
CombatSignals="*res://scripts/combat_signals.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[input]

# Input mappings - configure these in Godot editor after launch:
# action_move: W, A, S, D keys for movement
# action_fire: F key for firing
# cycle_unit: Page Down (25) for cycling units  
# end_turn: T key to end turn
# cancel: Page Up (24) for canceling actions

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
